{
  "name": "aula_playwright",
  "version": "1.0.0",
  "description": "Crescer: Automação de testes com Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:front": "playwright test tests/front",
    "test:api": "playwright test tests/api",
    "test:filters": "playwright test tests/front/home/home.spec.js -g \"filtrar\"",
    "test:home": "playwright test tests/front/home/home.spec.js",
    "test:cadastro": "playwright test tests/front/login/cadastro.spec.js",
    "test:login": "playwright test tests/front/login/login.spec.js",
    "test:e2e": "playwright test tests/front/e2e",
    "test:visual": "playwright test tests/front/home/home.spec.js -g \"Visual\"",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5"
  }
}
